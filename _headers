# Cloudflare Pages / Netlify read this file and apply these headers.
# It is the production counterpart to the header logic in tools/serve.mjs —
# if the two ever disagree, the game works locally and breaks live, which is
# the worst kind of bug. Keep them in step.

# Fonts and images are content-hashed or immutable; cache them hard.
/fonts/*
  Cache-Control: public, max-age=31536000, immutable

/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Site-wide hardening. The Content-Security-Policy itself is set per-page in
# src/layouts/Base.astro so it can vary; these are the headers that cannot be
# set from a <meta> tag and therefore have to live here.
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer
  X-Frame-Options: DENY
  # frame-ancestors only works as a header, never in a <meta> tag.
  Content-Security-Policy: frame-ancestors 'none'
  Permissions-Policy: geolocation=(), microphone=(), camera=(), interest-cohort=()
